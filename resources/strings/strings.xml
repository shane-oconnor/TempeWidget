<strings>
    <string id="AppName" scope="Background">TempeWidget</string>
    <!-- Shown in the on-device menu title. Bump by hand with each Store release;
         a Connect IQ manifest carries no version of its own. -->
    <string id="Version">1.1.0</string>

    <string id="GrpDisplay">Display</string>
    <string id="GrpS1">Sensor 1</string>
    <string id="GrpS2">Sensor 2</string>
    <string id="GrpS3">Sensor 3</string>
    <string id="GrpAdvanced">Advanced</string>

    <string id="LabelTitle">Name</string>
    <string id="IDTitle">Sensor ID</string>
    <string id="IDPrompt">0 = find a Tempe automatically (its ID is filled in here once found). -1 = the watch's own sensor. -2 = a Tempe paired in the watch's sensor menu. Or type a Tempe's ANT ID.</string>
    <string id="OffsetTitle">Offset (°C)</string>
    <string id="OffsetPrompt">Added to every reading from this sensor, in °C, before any conversion to °F.</string>

    <string id="TimeoutTitle">Keep a reading for</string>
    <string id="TimeoutPrompt">How long a reading stays on screen after the sensor goes quiet. It dims at the halfway point.</string>
    <string id="Min5">5 minutes</string>
    <string id="Min10">10 minutes</string>
    <string id="Min20">20 minutes</string>
    <string id="Min30">30 minutes</string>
    <string id="Min60">60 minutes</string>

    <string id="WhiteBGTitle">White background</string>
    <string id="BtryTitle">Show Tempe battery</string>
    <string id="BtryPrompt">The battery page can take a few minutes to arrive after a Tempe is found.</string>
    <string id="DbgTitle">Debug mode</string>
    <string id="DbgPrompt">Writes sensor and channel events to the log.</string>
</strings>
